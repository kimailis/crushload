# Dependencies & build output (reinstalled/rebuilt inside the image)
node_modules
dist

# VCS & local tooling
.git
.gitignore
*.log
*.tmp.mjs

# Secrets — never bake into the image (Cloud Run injects env vars at runtime)
.env
.env.*
!.env.example

# Docs & deploy files not needed at build time
